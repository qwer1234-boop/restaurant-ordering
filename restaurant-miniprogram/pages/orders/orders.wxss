/* pages/orders/orders.wxss 历史订单页 */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 数据来源提示条 */
.source-bar {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  padding: 14rpx 22rpx;
  border-radius: var(--radius-m);
  margin-bottom: 20rpx;
}
.source-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.source-online { background: #e8f9f0; color: var(--color-success); }
.source-online .source-dot { background: var(--color-success); }
.source-offline { background: #fff7e8; color: #d97706; }
.source-offline .source-dot { background: #d97706; }

/* 骨架屏 */
.skeleton-card { display: flex; flex-direction: column; gap: 20rpx; }
.sk-line {
  height: 28rpx;
  border-radius: var(--radius-s);
  background: linear-gradient(90deg, #f2f3f5 25%, #e5e6eb 50%, #f2f3f5 75%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.3s ease infinite;
}
@keyframes sk-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
.sk-w40 { width: 40%; }
.sk-w60 { width: 60%; }
.sk-w80 { width: 80%; }

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}
.empty-icon { font-size: 110rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-3); margin: 24rpx 0 40rpx; }
.empty-btn {
  background: var(--gradient-primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: var(--radius-pill);
  padding: 18rpx 64rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.35);
}
.empty-btn:active { transform: scale(0.95); }

/* ---------- 订单卡片 ---------- */
.order-card {
  background: var(--color-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.order-no { font-size: 26rpx; color: var(--color-text-2); display: flex; align-items: center; }
.no-label {
  font-size: 20rpx;
  color: var(--color-text-4);
  background: #f2f3f5;
  border-radius: var(--radius-s);
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}

/* 状态彩色标签 */
.order-status {
  font-size: 22rpx;
  font-weight: bold;
  border-radius: var(--radius-pill);
  padding: 8rpx 20rpx;
}
.status-pending { background: #fff4ee; color: var(--color-primary); }
.status-cooking { background: #e8f1ff; color: var(--color-info); }
.status-done    { background: #e8f9f0; color: var(--color-success); }
.status-cancel  { background: #f2f3f5; color: var(--color-cancel); }
.status-local   { background: #fff7e8; color: #d97706; }

/* 状态进度点 */
.timeline {
  display: flex;
  align-items: center;
  padding: 6rpx 0 20rpx;
}
.tl-node { display: flex; flex-direction: column; align-items: center; }
.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e5e6eb;
}
.tl-done .tl-dot { background: var(--color-primary); }
.tl-current {
  box-shadow: 0 0 0 6rpx rgba(255, 107, 53, 0.18);
  animation: tl-pulse 1.6s ease-in-out infinite;
}
@keyframes tl-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(255, 107, 53, 0.18); }
  50% { box-shadow: 0 0 0 10rpx rgba(255, 107, 53, 0.08); }
}
.tl-text { font-size: 20rpx; color: var(--color-text-4); margin-top: 8rpx; }
.tl-done .tl-text { color: var(--color-primary); }
.tl-line {
  flex: 1;
  height: 2rpx;
  background: #e5e6eb;
  margin: 0 10rpx;
  margin-bottom: 34rpx;
}
.tl-line-on { background: var(--color-primary); }

.order-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}
.table-tag {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 22rpx;
  border-radius: var(--radius-s);
  padding: 6rpx 16rpx;
}
.order-time { color: var(--color-text-4); font-size: 22rpx; }
.order-summary {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.summary-text {
  font-size: 26rpx;
  color: var(--color-text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}
.order-total { color: var(--color-price); font-weight: bold; font-size: 34rpx; }
.total-s { font-size: 22rpx; }

/* 展开明细：高度过渡动画 */
.order-detail {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.3s ease, opacity 0.25s ease, margin-top 0.3s ease, padding-top 0.3s ease;
}
.detail-open {
  max-height: 800rpx;
  opacity: 1;
  border-top: 1rpx solid var(--color-border);
  margin-top: 18rpx;
  padding-top: 14rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-1);
  padding: 8rpx 0;
}
.detail-dish { display: flex; align-items: center; }
.detail-img { width: 52rpx; height: 52rpx; border-radius: 8rpx; margin-right: 12rpx; flex-shrink: 0; }
.detail-price { color: var(--color-price); }
.detail-note {
  font-size: 24rpx;
  color: var(--color-text-3);
  margin-top: 10rpx;
  background: #f7f8fa;
  border-radius: var(--radius-s);
  padding: 12rpx 16rpx;
}

/* 展开/收起条 */
.toggle-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}
.toggle-text { font-size: 22rpx; color: var(--color-text-3); }
.toggle-arrow {
  font-size: 26rpx;
  color: var(--color-text-3);
  margin-left: 8rpx;
  transition: transform 0.25s ease;
}
.arrow-up { transform: rotate(180deg); }
