/* pages/orders/orders.wxss */
.page {
  padding: 24rpx;
}

/* 数据来源提示条 */
.source-bar {
  font-size: 22rpx;
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}
.source-online { background: #e8f7ee; color: #17a05e; }
.source-offline { background: #fff3e6; color: #d97706; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  color: #999;
}
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; }

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
}
.order-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.order-no { font-size: 26rpx; color: #666; }
.order-status { font-size: 26rpx; color: #ff7a3c; font-weight: bold; }
.order-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.order-time { color: #999; }
.order-summary {
  font-size: 26rpx;
  color: #666;
  display: flex;
  justify-content: space-between;
}
.order-total { color: #ff4d00; font-weight: bold; font-size: 30rpx; }

.order-detail {
  border-top: 1rpx solid #f2f2f2;
  margin-top: 18rpx;
  padding-top: 14rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333;
  padding: 8rpx 0;
}
.detail-price { color: #ff4d00; }
.detail-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
