<!--pages/orders/orders.wxml 历史订单页-->
<view class="page">

  <!-- 数据来源提示 -->
  <view class="source-bar {{dataSource === 'server' ? 'source-online' : 'source-offline'}}" wx:if="{{!loading}}">
    <view class="source-dot"></view>
    {{dataSource === 'server' ? '数据来自后端数据库，实时同步' : '后端未连接，展示本地缓存订单'}}
  </view>

  <!-- 加载中骨架 -->
  <view wx:if="{{loading}}" class="order-card skeleton-card">
    <view class="sk-line sk-w40"></view>
    <view class="sk-line sk-w80"></view>
    <view class="sk-line sk-w60"></view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && orders.length === 0}}" class="empty">
    <text class="empty-icon">🍽️</text>
    <text class="empty-text">还没有订单，去点一单吧～</text>
    <view class="empty-btn" bindtap="onGoMenu">去点餐</view>
  </view>

  <view class="order-card" wx:for="{{orders}}" wx:key="id">
    <!-- 头部：订单号 + 状态标签 -->
    <view class="order-head" data-index="{{index}}" bindtap="onToggle">
      <view class="order-no">
        <text class="no-label">订单号</text>
        <text>{{item.id}}</text>
      </view>
      <view class="order-status status-{{item.statusType}}">{{item.status}}</view>
    </view>

    <!-- 状态进度点（待处理 → 制作中 → 已完成） -->
    <view class="timeline" wx:if="{{!item.cancelled}}">
      <view class="tl-node tl-done"><view class="tl-dot"></view><text class="tl-text">待处理</text></view>
      <view class="tl-line {{item.step >= 1 ? 'tl-line-on' : ''}}"></view>
      <view class="tl-node {{item.step >= 1 ? 'tl-done' : ''}}">
        <view class="tl-dot {{item.step === 1 ? 'tl-current' : ''}}"></view>
        <text class="tl-text">制作中</text>
      </view>
      <view class="tl-line {{item.step >= 2 ? 'tl-line-on' : ''}}"></view>
      <view class="tl-node {{item.step >= 2 ? 'tl-done' : ''}}">
        <view class="tl-dot"></view>
        <text class="tl-text">已完成</text>
      </view>
    </view>

    <view class="order-info">
      <view class="table-tag">🪑 {{item.tableNo}}</view>
      <text class="order-time">{{item.time}}</text>
    </view>
    <view class="order-summary">
      <text class="summary-text">{{item.items[0].name}} 等 {{item.items.length}} 种菜品</text>
      <text class="order-total"><text class="total-s">¥</text>{{item.total}}</text>
    </view>

    <!-- 展开的明细 -->
    <view class="order-detail {{item.expanded ? 'detail-open' : ''}}">
      <view class="detail-row" wx:for="{{item.items}}" wx:for-item="dish" wx:key="id">
        <text>{{dish.emoji}} {{dish.name}} × {{dish.count}}</text>
        <text class="detail-price">¥{{dish.count * dish.price}}</text>
      </view>
      <view class="detail-note" wx:if="{{item.note}}">备注：{{item.note}}</view>
    </view>

    <!-- 展开/收起提示 -->
    <view class="toggle-bar" data-index="{{index}}" catchtap="onToggle">
      <text class="toggle-text">{{item.expanded ? '收起明细' : '查看明细'}}</text>
      <text class="toggle-arrow {{item.expanded ? 'arrow-up' : ''}}">⌄</text>
    </view>
  </view>

</view>
