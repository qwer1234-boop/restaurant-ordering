<view class="stats-page">
  <view class="hero">
    <view class="hero-title">经营统计</view>
    <view class="hero-sub">数据来自已完成 / 进行中的订单，已取消订单不计入</view>
  </view>

  <view class="grid" wx:if="{{summary}}">
    <view class="grid-card">
      <view class="grid-num">{{summary.today.orderCount || 0}}</view>
      <view class="grid-label">今日订单</view>
    </view>
    <view class="grid-card">
      <view class="grid-num">¥{{summary.today.turnover || 0}}</view>
      <view class="grid-label">今日营业额</view>
    </view>
    <view class="grid-card">
      <view class="grid-num">¥{{summary.total.avgOrderAmount || 0}}</view>
      <view class="grid-label">平均客单价</view>
    </view>
    <view class="grid-card">
      <view class="grid-num">{{summary.pendingOrders || 0}}</view>
      <view class="grid-label">待处理订单</view>
    </view>
  </view>

  <view class="card" wx:if="{{summary}}">
    <view class="card-title">累计经营</view>
    <view class="row">
      <text class="row-label">累计订单</text>
      <text class="row-value">{{summary.total.orderCount || 0}} 单</text>
    </view>
    <view class="row">
      <text class="row-label">累计营业额</text>
      <text class="row-value strong">¥{{summary.total.turnover || 0}}</text>
    </view>
    <view class="row">
      <text class="row-label">累计菜品份数</text>
      <text class="row-value">{{summary.total.dishCount || 0}} 份</text>
    </view>
    <view class="row">
      <text class="row-label">餐桌占用</text>
      <text class="row-value">{{summary.tableStat.usingCount || 0}} / {{summary.tableStat.totalCount || 0}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{topDishes.length}}">
    <view class="card-title">热销榜</view>
    <view class="rank-row" wx:for="{{topDishes}}" wx:key="dishId">
      <view class="rank-index rank-{{index}}">{{index + 1}}</view>
      <view class="rank-name">{{item.emoji}} {{item.name}}</view>
      <view class="rank-count">{{item.soldCount}} 份</view>
    </view>
  </view>

  <view class="card" wx:if="{{categoryStats.length}}">
    <view class="card-title">分类营业额占比</view>
    <view class="bar-row" wx:for="{{categoryStats}}" wx:key="categoryName">
      <view class="bar-head">
        <text class="bar-name">{{item.categoryName}}</text>
        <text class="bar-value">¥{{item.amount}}</text>
      </view>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{item.percent}}%"></view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !topDishes.length}}">
    <view class="empty-icon">📈</view>
    <view class="empty-text">还没有经营数据</view>
  </view>
</view>
