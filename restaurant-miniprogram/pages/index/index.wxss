/* pages/index/index.wxss 点餐主页样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 门店信息条 */
.shop-bar {
  background: #ff7a3c;
  color: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.shop-name { font-size: 32rpx; font-weight: bold; }
.shop-tip { font-size: 24rpx; opacity: 0.9; }

/* 主体区域 */
.main {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类 */
.cat-list {
  width: 180rpx;
  background: #f0f0f0;
  height: 100%;
}
.cat-item {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-left: 6rpx solid transparent;
}
.cat-active {
  background: #fff;
  color: #ff7a3c;
  font-weight: bold;
  border-left-color: #ff7a3c;
}

/* 右侧菜品列表 */
.dish-list {
  flex: 1;
  background: #fff;
  height: 100%;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}
.dish-card {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.dish-emoji {
  width: 130rpx;
  height: 130rpx;
  background: #fff5ee;
  border-radius: 16rpx;
  font-size: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.dish-name { font-size: 30rpx; font-weight: bold; }
.dish-desc { font-size: 22rpx; color: #999; }
.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dish-price { color: #ff4d00; font-size: 32rpx; font-weight: bold; }
.add-btn {
  width: 52rpx;
  height: 52rpx;
  background: #ff7a3c;
  color: #fff;
  border-radius: 50%;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.list-end {
  text-align: center;
  color: #ccc;
  font-size: 22rpx;
  padding: 30rpx 0;
}

/* 购物车展开面板 */
.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 110rpx;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.08);
  display: none;
}
.cart-panel-open { display: block; }
.cart-head {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #f2f2f2;
}
.cart-clear { font-size: 24rpx; color: #999; font-weight: normal; }
.cart-items { max-height: 400rpx; }
.cart-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
}
.cart-name { font-size: 28rpx; }
.cart-ops { display: flex; align-items: center; }
.price-s { color: #ff4d00; margin-right: 20rpx; }
.op {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #fff;
}
.op-minus { background: #fff; border: 2rpx solid #ff7a3c; color: #ff7a3c; }
.op-add { background: #ff7a3c; }
.op-count { width: 60rpx; text-align: center; }

/* 底部购物车栏 */
.cart-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  height: 100rpx;
  background: #2b2b2b;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  z-index: 10;
}
.cart-icon-wrap {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  margin-top: -30rpx;
  margin-left: 10rpx;
  background: #2b2b2b;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}
.cart-badge {
  position: absolute;
  top: 0;
  right: 6rpx;
  min-width: 34rpx;
  height: 34rpx;
  background: #ff4d00;
  color: #fff;
  border-radius: 17rpx;
  font-size: 22rpx;
  text-align: center;
  line-height: 34rpx;
}
.cart-total {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  padding-left: 10rpx;
}
.cart-empty-tip { font-size: 26rpx; color: #888; font-weight: normal; }
.checkout-btn {
  width: 200rpx;
  height: 100rpx;
  background: #ff7a3c;
  color: #fff;
  border-radius: 50rpx;
  text-align: center;
  line-height: 100rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.checkout-disabled { background: #5a5a5a; color: #aaa; }
