.dishes-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1d2129;
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #86909c;
}

.btn-add {
  padding: 16rpx 28rpx;
  background: #ff6b35;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.btn-add:active {
  opacity: 0.85;
}

.dish-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.dish-card.off-shelf {
  opacity: 0.65;
}

.dish-main {
  display: flex;
  align-items: flex-start;
}

.dish-emoji {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 52rpx;
  background: #fff7e8;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
}

.dish-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.dish-status.on {
  color: #00b42a;
  background: #e8ffea;
}

.dish-status.off {
  color: #86909c;
  background: #f2f3f5;
}

.dish-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4e5969;
}

.dish-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1px solid #f2f3f5;
}

.btn-edit,
.btn-toggle {
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.btn-edit {
  color: #4e5969;
  background: #f2f3f5;
}

.btn-toggle.off {
  color: #f53f3f;
  background: #ffece8;
}

.btn-toggle.on {
  color: #00b42a;
  background: #e8ffea;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #86909c;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.editor {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.editor-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d2129;
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-bottom: 1px solid #f2f3f5;
}

.form-label {
  width: 110rpx;
  font-size: 28rpx;
  color: #4e5969;
}

.form-input,
.form-picker {
  flex: 1;
  font-size: 28rpx;
}

.picker-value {
  padding: 18rpx 0;
  color: #1d2129;
}

.editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-editor-cancel,
.btn-editor-save {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn-editor-cancel {
  background: #f2f3f5;
  color: #4e5969;
}

.btn-editor-save {
  background: #ff6b35;
  color: #ffffff;
}

.btn-editor-save.disabled {
  opacity: 0.55;
}
