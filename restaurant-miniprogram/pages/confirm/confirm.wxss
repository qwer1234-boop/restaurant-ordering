/* pages/confirm/confirm.wxss 订单确认页 */
.page {
  padding: 24rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--color-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  color: var(--color-text-1);
}
.title-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--gradient-primary);
  margin-right: 14rpx;
}

/* 明细行 */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}
.row-left { display: flex; align-items: center; flex: 1; overflow: hidden; }
.row-emoji { font-size: 36rpx; margin-right: 14rpx; }
.name { color: var(--color-text-1); }
.count { color: var(--color-text-3); font-size: 24rpx; margin-left: 12rpx; }
.right { display: flex; align-items: center; flex-shrink: 0; }
.price { color: var(--color-price); font-weight: bold; margin-right: 20rpx; }
.minus {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  transition: transform 0.12s ease;
}
.minus:active { transform: scale(0.85); }

/* 金额明细 */
.fee-rows {
  border-top: 1rpx solid var(--color-border);
  margin-top: 14rpx;
  padding-top: 18rpx;
}
.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.fee-label { color: var(--color-text-3); }
.fee-value { color: var(--color-text-2); }
.fee-free { color: var(--color-success); }

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-top: 1rpx solid var(--color-border);
  padding-top: 20rpx;
  margin-top: 12rpx;
}
.total-count { color: var(--color-text-3); font-size: 24rpx; }
.total { color: var(--color-text-2); }
.total-price { color: var(--color-price); font-size: 40rpx; font-weight: bold; }

/* ---------- 桌号快选 ---------- */
.table-picker {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0 4rpx;
}
.table-chip {
  padding: 14rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f2f3f5;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--color-text-2);
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  transition: all 0.15s ease;
}
.chip-seats { font-size: 20rpx; color: var(--color-text-4); margin-left: 8rpx; }
.table-chip-active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-weight: bold;
  border-color: var(--color-primary);
}
.table-chip-active .chip-seats { color: var(--color-primary-light); }
.table-chip-busy { opacity: 0.45; }
.table-chip:active { transform: scale(0.95); }

/* ---------- 表单 ---------- */
.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.form-row:last-of-type { border-bottom: none; }
.label { width: 110rpx; color: var(--color-text-2); font-size: 28rpx; }
.input { flex: 1; font-size: 28rpx; }
.input-ph { color: var(--color-text-4); }

/* 备注快捷标签 */
.quick-notes {
  display: flex;
  flex-wrap: wrap;
  padding-top: 16rpx;
}
.note-chip {
  padding: 10rpx 24rpx;
  margin: 0 14rpx 14rpx 0;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  transition: transform 0.12s ease;
}
.note-chip:active { transform: scale(0.93); }

/* ---------- 底部固定提交栏 ---------- */
.bottom-gap { height: 150rpx; }
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}
.submit-total { flex: 1; display: flex; align-items: baseline; }
.submit-label { font-size: 24rpx; color: var(--color-text-3); margin-right: 12rpx; }
.submit-symbol { font-size: 26rpx; color: var(--color-price); font-weight: bold; }
.submit-price { font-size: 44rpx; color: var(--color-price); font-weight: bold; }
.submit-btn {
  width: 240rpx;
  height: 88rpx;
  background: var(--gradient-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.35);
  transition: transform 0.12s ease, opacity 0.2s;
}
.submit-btn:active { transform: scale(0.96); }
.submit-loading { opacity: 0.7; }
