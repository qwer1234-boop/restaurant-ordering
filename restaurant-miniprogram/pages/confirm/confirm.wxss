/* pages/confirm/confirm.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
}
.right { display: flex; align-items: center; }
.price { color: #ff4d00; margin-right: 20rpx; }
.minus {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #ff7a3c;
  color: #ff7a3c;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
}

.total-row {
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid #f2f2f2;
  padding-top: 20rpx;
  margin-top: 10rpx;
  color: #666;
}
.total { color: #333; }
.total-price { color: #ff4d00; font-size: 36rpx; font-weight: bold; }

/* 桌号快选 */
.table-picker {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 16rpx;
}
.table-chip {
  padding: 10rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}
.table-chip-active {
  background: #ffe6d6;
  color: #ff7a3c;
  font-weight: bold;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.label { width: 110rpx; color: #666; }
.input { flex: 1; font-size: 28rpx; }

.submit-btn {
  margin-top: 40rpx;
  background: #ff7a3c;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
}
.submit-btn::after { border: none; }
