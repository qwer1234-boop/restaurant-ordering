.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: #2c2c2a;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.login-icon {
  font-size: 88rpx;
  line-height: 1;
}

.login-title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #1d2129;
}

.login-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #86909c;
}

.pwd-input {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  box-sizing: border-box;
}

.pwd-placeholder {
  color: #c9cdd4;
  letter-spacing: 0;
}

.error-tip {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #f53f3f;
}

.btn-login {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #2c2c2a;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 16rpx;
}

.btn-login:active {
  opacity: 0.85;
}

.btn-login.disabled {
  opacity: 0.55;
}

.btn-cancel {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #86909c;
  padding: 12rpx 30rpx;
}

.login-hint {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #86909c;
}

/* 密码错误抖动 */
.shake {
  animation: shake 0.4s;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-16rpx); }
  50% { transform: translateX(16rpx); }
  75% { transform: translateX(-16rpx); }
}
