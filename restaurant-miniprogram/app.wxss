/* app.wxss 全局样式 */
page {
  background: #f6f6f6;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

/* 通用橙色按钮 */
.btn-primary {
  background: #ff7a3c;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.btn-primary::after {
  border: none;
}
